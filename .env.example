# App and isolated page origins. On localhost both may be localhost:3000; the preview iframe is sandboxed.
APP_ORIGIN=http://localhost:3000
PUBLIC_PAGE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PAGE_ORIGIN=http://localhost:3000

# Canonical public URL of the main site, used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://mintamaaf.online

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# One active Stitch account/key. A spare key is kept outside this app for manual replacement.
STITCH_API_KEY=
MOCK_GENERATOR=false

# One free Supabase project: Postgres tables, private Storage bucket, pg_cron/pg_net job dispatch.
# Project URL and service_role secret (Dashboard -> Project Settings -> API). Server-only; never expose.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the internal job worker endpoint, `openssl rand -base64 48`.
# Must match the `jobs_secret` row in the app_config table (see supabase/migrations/0001_init.sql).
JOBS_SECRET=

# inline = run jobs in-process after the response (local dev; no public URL needed).
# supabase = pg_net/pg_cron dispatch through the worker URL (production default).
JOBS_MODE=inline

# Bearer token for the daily cleanup cron, `openssl rand -base64 48`.
CRON_SECRET=

# At least 32 random bytes, e.g. `openssl rand -base64 48`.
PREVIEW_SIGNING_KEY=

# Beta: effectively unlimited. The counting/limiting infrastructure stays active,
# so re-tightening later is only a matter of lowering these numbers.
GENERATIONS_PER_SESSION_DAY=999999
REVISIONS_PER_PAGE=999999
GLOBAL_DAILY_GENERATION_CAP=999999
GENERATIONS_PER_IP_DAY=999999
PAGE_EXPIRY_DAYS=7
