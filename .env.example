# App and isolated page origins. On localhost both may be localhost:3000; the preview iframe is sandboxed.
APP_ORIGIN=http://localhost:3000
PUBLIC_PAGE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_PAGE_ORIGIN=http://localhost:3000

# One active Stitch account/key. A spare key is kept outside this app for manual replacement.
STITCH_API_KEY=
MOCK_GENERATOR=false

# At least 32 random bytes, e.g. `openssl rand -base64 48`.
PREVIEW_SIGNING_KEY=

# Vercel Blob private store and Upstash Redis + QStash.
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=

GENERATIONS_PER_SESSION_DAY=1
REVISIONS_PER_PAGE=1
GLOBAL_DAILY_GENERATION_CAP=20
MAX_CONCURRENT_JOBS=1
PAGE_EXPIRY_DAYS=7
